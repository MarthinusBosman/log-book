# PUBLIC mode — your own domain on the internet, real Let's Encrypt certificate.
# Used by `docker compose --profile https up -d` (docs/SELF_HOSTING.md → "Custom domain").
#
# Needs: a DNS A (and/or AAAA) record for DOMAIN pointing at this machine's public IP, and ports
# 80 + 443 forwarded/open to it. Caddy gets and renews the certificate on its own.
#
# .env:  DOMAIN=manifest.mydz.co.za
#        ORIGIN=https://manifest.mydz.co.za
#        PROTOCOL_HEADER=x-forwarded-proto
#        HOST_HEADER=x-forwarded-host
#        ADDRESS_HEADER=x-forwarded-for
#        XFF_DEPTH=1
#
# Without Docker: UPSTREAM=127.0.0.1:3000 caddy run --config deploy/Caddyfile.public
{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
}

{$DOMAIN:localhost} {
	encode zstd gzip
	# Uploads are capped at 10 MB by the app.
	request_body {
		max_size 12MB
	}
	reverse_proxy {$UPSTREAM:app:3000}
}
