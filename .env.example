# Copy to .env — used by `bun run dev`, `bun run start` and docker compose.
# Full reference: docs/SELF_HOSTING.md (self-hosted) and docs/DEPLOY.md (Cloudflare).
# Cloudflare: non-secret values go in wrangler.jsonc "vars", secrets via `wrangler secret put`
# (local `wrangler dev`: .dev.vars).

# Build-time target: bun (self-hosted, default) | cloudflare (hosted). Read by vite.config.ts.
# DEPLOY_TARGET=bun

# global = hosted multi-dropzone instance / identity provider; dropzone = self-hosted single DZ.
# Defaults: cloudflare -> global, bun -> dropzone.
# INSTANCE_MODE=dropzone

# Public URL (emails, OAuth redirect URIs). Defaults to the request origin.
# APP_ORIGIN=https://manifest.example.com

# REQUIRED in production: long random string (openssl rand -base64 48). Encrypts stored
# payment-provider secrets. Changing it later makes saved PayFast credentials unreadable.
# SECRETS_KEY=

# Uploaded files: disk (UPLOADS_DIR, bun default) | db (inside the database) | r2 (Cloudflare R2 binding FILES)
# STORAGE_DRIVER=disk

# Bun target only
DATABASE_PATH=data/app.db
MIGRATIONS_DIR=drizzle
# UPLOADS_DIR=data/uploads

# adapter-node runtime (`bun build/server.js`)
# PORT=3000
# ORIGIN=http://localhost:3000
# BODY_SIZE_LIMIT=12M                 # build/server.js defaults to 12M (adapter-node alone: 512K)
# PROTOCOL_HEADER=x-forwarded-proto   # behind a TLS reverse proxy
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# docker compose: which image release to run. Default latest; pin e.g. 0.1.0 (or 0.1 for patch
# updates only) so `docker compose pull` never jumps a version you haven't read the notes for.
# LOG_BOOK_VERSION=latest
# LOG_BOOK_IMAGE=ghcr.io/marthinusbosman/log-book   # only to use a mirror / your own build

# docker compose front end, so plain `docker compose up -d` / `pull` include it (or pass --profile):
# COMPOSE_PROFILES=https

# docker compose front ends (pick one; docs/SELF_HOSTING.md):
# --profile https     (own domain, Let's Encrypt)
# DOMAIN=manifest.example.com
# --profile tunnel    (Cloudflare Tunnel; public hostname service = http://app:3000)
# TUNNEL_TOKEN=
# --profile lan       (dropzone WiFi, HTTPS via Caddy's local CA; certificate at http://<server>/ca.crt)
# LAN_HOSTS=logbook.internal, logbook.local, 192.168.1.10
# --profile lan-http  (dropzone WiFi, plain HTTP on port 80)
# For both LAN profiles: ORIGIN=  (empty = accept every name above) + PROTOCOL_HEADER/HOST_HEADER.
# APP_BIND=127.0.0.1                  # hide port 3000 from the network when a front end is used

# Bearer secret for POST /api/cron from outside (bun runs housekeeping hourly in-process anyway)
# CRON_SECRET=

# Federation (dropzone instances linking to the hosted instance) — or set them in the UI
# FEDERATION_GLOBAL_URL=
# FEDERATION_CLIENT_ID=
# FEDERATION_CLIENT_SECRET=
# FEDERATION_FLUSH_SECRET=
